APP_NAME=connected-vehicle-aiot-enterprise
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CLOUD_RUNTIME=localstack
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_NAME=connected_vehicle
DATABASE_USERNAME=connected_vehicle
DATABASE_PASSWORD=connected_vehicle
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_HEALTH_TIMEOUT_SECONDS=3

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
REDIS_KEY_PREFIX=connected-vehicle