APP_NAME=connected-vehicle-aiot-enterprise
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CLOUD_RUNTIME=localstack
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3
VEHICLE_COMMAND_QUEUE_NAME=connected-vehicle-command
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_NAME=connected_vehicle
# DATABASE_USERNAME/PASSWORD are reserved for the local PostgreSQL container owner.
DATABASE_USERNAME=connected_vehicle
DATABASE_PASSWORD=connected_vehicle
MIGRATION_DATABASE_USERNAME=connected_vehicle
MIGRATION_DATABASE_PASSWORD=connected_vehicle
APPLICATION_DATABASE_SECRET_ID=/connected-vehicle/local/database/application
OUTBOX_DATABASE_SECRET_ID=/connected-vehicle/local/database/outbox
REMOTE_COMMAND_DATABASE_SECRET_ID=/connected-vehicle/local/database/remote-command
# Provisioning only: set distinct passwords securely in the provisioning process.
# APP_USER_PASSWORD=...
# OUTBOX_WORKER_PASSWORD=...
# REMOTE_COMMAND_WORKER_PASSWORD=...
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_HEALTH_TIMEOUT_SECONDS=3

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
REDIS_KEY_PREFIX=connected-vehicle

# Independent runtimes: python -m apps.api / apps.outbox / apps.remote_command
# Optional single-tenant service identity. Provision a random token (>=32 chars)
# and API_SERVICE_TENANT_ID together. No configured token means no implicit login.
# API_SERVICE_TOKEN=
# API_SERVICE_TENANT_ID=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
# AWS mode requires verified TLS. Configure CA and optional client cert/key paths.
# MQTT_CA_FILE=
# MQTT_CERT_FILE=
# MQTT_KEY_FILE=
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TIMEOUT_SECONDS=5
REMOTE_COMMAND_WAIT_SECONDS=5
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_ERROR_DELAY_SECONDS=2
WORKER_OPERATION_TIMEOUT_SECONDS=25
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
