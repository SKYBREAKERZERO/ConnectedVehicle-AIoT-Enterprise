# Local backup and isolated recovery exercises only.
BACKUP_PROFILE=local

# PostgreSQL source.
# Match the host port configured in docker-compose.yml.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=connected_vehicle
PGUSER=backup_reader
PGCONNECT_TIMEOUT=5

# Provision this private password file separately.
# Do not commit its contents or place passwords in this example.
PGPASSFILE=D:/project/ConnectedVehicle-AIoT-Enterprise/.device/backup/pgpass

# PostgreSQL client major version expected by the backup scripts.
BACKUP_POSTGRES_MAJOR_VERSION=16

# Private backup destination, already excluded by the repository .gitignore.
BACKUP_ROOT=D:/project/ConnectedVehicle-AIoT-Enterprise/backups

# Preserve checkpoints and their complete hash-linked audit directory together.
BACKUP_CREDENTIAL_AUDIT_SOURCE=D:/project/ConnectedVehicle-AIoT-Enterprise/.runtime-reports/credential-operations

# Backup archives must be encrypted before publication.
BACKUP_ENCRYPTION_REQUIRED=true

# Cross-system backup requires a controlled maintenance window.
# The operator must stop relevant writers before acknowledging this.
BACKUP_MAINTENANCE_CONFIRMED=false

# Bound external command execution.
BACKUP_TIMEOUT_SECONDS=900

# Recovery must create a new isolated database.
RESTORE_DATABASE_PREFIX=cv_restore_