# Local deployment only.
APP_ENV=local
CLOUD_RUNTIME=localstack

# LocalStack endpoint accessible from the host.
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566

# Dummy credentials for LocalStack only.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true

# PostgreSQL endpoint accessible from the host.
# Match POSTGRES_HOST_PORT in docker-compose.yml.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=connected_vehicle

# Cluster role management identity.
BOOTSTRAP_DATABASE_USERNAME=connected_vehicle

# Independent schema migration identity.
MIGRATION_DATABASE_USERNAME=migration_owner

# Bounded database operations.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_HEALTH_TIMEOUT_SECONDS=3
DATABASE_LOCK_TIMEOUT_SECONDS=2
DATABASE_STATEMENT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TRANSACTION_TIMEOUT_SECONDS=30

# Migration-specific timeouts.
MIGRATION_LOCK_TIMEOUT_SECONDS=5
MIGRATION_STATEMENT_TIMEOUT_SECONDS=60

# Runtime secret naming.
DATABASE_SECRET_PREFIX=/connected-vehicle

# Normal schema deployment must not implicitly enable password rotation.
CREDENTIAL_ROTATION_MAINTENANCE_MODE=false

# Supply management passwords separately through the deployment environment.
# Do not put real passwords in this example file.
#
# Required for cluster bootstrap:
# BOOTSTRAP_DATABASE_PASSWORD
#
# Required for schema migration and GRANT:
# MIGRATION_DATABASE_PASSWORD