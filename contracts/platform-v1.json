          "honk",
          "flash_lights"
        ],
        "title": "RemoteCommandType",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
