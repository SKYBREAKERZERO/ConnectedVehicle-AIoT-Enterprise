  },
  "telemetry/1.0": {
    "additionalProperties": false,
    "properties": {
      "battery_percent": {
        "maximum": 100,
        "minimum": 0,
        "title": "Battery Percent",
        "type": "number"
      },
      "event_id": {
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "measured_at": {
        "format": "date-time",
        "title": "Measured At",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "speed_kph": {
        "maximum": 300,
        "minimum": 0,
        "title": "Speed Kph",
        "type": "number"
      },
      "temperature_c": {
        "maximum": 180,
        "minimum": -80,
        "title": "Temperature C",
        "type": "number"
      }
    },
    "required": [
      "event_id",
      "measured_at",
      "speed_kph",
      "battery_percent",
      "temperature_c"
    ],
    "title": "TelemetrySample",
    "type": "object"
  }
}
